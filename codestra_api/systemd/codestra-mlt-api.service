[Unit]
Description=codestra-mlt-api
After=network.target

[Service]
Type=simple
User=videoctl
Group=videoctl
WorkingDirectory=/srv/codestra-video
Environment=CODESTRA_VIDEO_ROOT=/srv/codestra-video
Environment=CODESTRA_VIDEO_MAX_JOBS=1
Environment=CODESTRA_VIDEO_RENDER_ENABLED=1
EnvironmentFile=-/etc/codestra-video/mlt.env
ExecStart=/usr/bin/python3 /opt/codestra-video/mlt-api/server.py --host 127.0.0.1 --port 18102
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/codestra-video

[Install]
WantedBy=multi-user.target
